filters:
  and:
    - or:
        - file.hasTag("topic/デザインシステム")
        - file.hasTag("topic/デザインシステム/デザイントークン")
        - file.hasTag("topic/デザインシステム/デザイントークン/DTCG")
        - file.hasTag("topic/デザインシステム/コンポーネント設計")
        - file.hasTag("topic/デザインシステム/配信基盤")
        - file.hasTag("topic/デザインシステム/ガバナンス")
        - file.hasTag("topic/デザインシステム/連合型DS")
        - file.hasTag("topic/デザインシステム/ROI")
    - file.hasTag("topic/AI")
properties:
  file.name:
    displayName: Name
  Created:
    displayName: Created
  Tags:
    displayName: Tags
  URL:
    displayName: URL
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Created
      - Tags
      - URL
    columnSize:
      file.name: 597
      note.tags: 342
