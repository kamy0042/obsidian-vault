filters:
  and:
    - or:
        - file.hasTag("topic/デザインシステム/デザイントークン")
        - file.hasTag("topic/デザインシステム/デザイントークン/DTCG")
properties:
  file.name:
    displayName: 名前
  タグ:
    displayName: タグ
  作成日時:
    displayName: 作成日時
  Tags:
    displayName: Tags
  URL:
    displayName: URL
views:
  - type: table
    name: Table View
    order:
      - file.name
      - タグ
      - 作成日時
      - Tags
      - URL
