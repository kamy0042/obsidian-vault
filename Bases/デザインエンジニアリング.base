filters:
  and:
    - file.hasTag("topic/組織/デザインエンジニアリング")
properties:
  file.name:
    displayName: 名前
  タグ:
    displayName: タグ
  作成日時:
    displayName: 作成日時
  Tags:
    displayName: Tags
  URL:
    displayName: URL
views:
  - type: table
    name: Table View
    order:
      - file.name
      - タグ
      - 作成日時
      - Tags
      - URL
  - type: list
    name: リストビュー
    cardSize: 800
    markers: bullet
    indentProperties: false
