filters:
  and:
    - file.hasTag("topic/デザインシステム/コンポーネント設計")
properties:
  file.name:
    displayName: Name
  Created:
    displayName: Created
  Tags:
    displayName: Tags
  URL:
    displayName: URL
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Created
      - Tags
      - URL
