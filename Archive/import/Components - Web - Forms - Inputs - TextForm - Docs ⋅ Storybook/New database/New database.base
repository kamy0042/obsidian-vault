# New database

filters:
  and:
    - note["base"] == link("New database.base")
properties:
  file.name:
    displayName: 通常サイズ
  isLargeサイズ:
    displayName: isLargeサイズ
  Files:
    displayName: Files
views:
  - type: table
    name: Table View
    order:
      - file.name
      - isLargeサイズ
      - Files
